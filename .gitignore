fake/strange/venv/
fake/strange/env/
fake/strange/.conda/
# pip 离线安装的临时产物
fake/strange/.piptmp/
fake/strange/.wheels/

# Node
fake/strange/node_modules/
fake/strange/.npm-cache/
fake/strange/.npm-logs/

# ===== 构建产物 =====
fake/strange/dist/
fake/strange/build/
fake/strange/*.egg-info/

# ===== Python 缓存 =====
fake/strange/__pycache__/
fake/strange/*.py[cod]
fake/strange/*$py.class
fake/strange/.pytest_cache/
fake/strange/.mypy_cache/
fake/strange/.ruff_cache/
fake/strange/.coverage
fake/strange/htmlcov/

# ===== 运行时数据（首次启动自动生成，勿提交）=====
fake/strange/backend/data/

# ===== 生成图片输出 =====
fake/strange/output/

# ===== 配置 / 密钥 =====
# config.json 含 API Key 等敏感信息，请勿提交
fake/strange/config.json
fake/strange/.env
fake/strange/.env.*
!fake/strange/.env.example
!fake/strange/config.example.json

# ===== IDE / 编辑器 =====
fake/strange/.idea/
fake/strange/.vscode/
